{
  "policy": "scripts/ci-policy.mjs",
  "go": true,
  "vite": [
    "frontend"
  ],
  "check": [
    {
      "command": "go",
      "args": [
        "vet",
        "-mod=readonly",
        "./..."
      ],
      "cwd": "backend"
    },
    {
      "command": "npm",
      "args": [
        "run",
        "check"
      ],
      "cwd": "frontend"
    }
  ],
  "format": [
    {
      "command": "npm",
      "args": [
        "run",
        "fmt"
      ],
      "cwd": "frontend"
    }
  ]
}
