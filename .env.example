# Copy this file to .env beside docker-compose.yml (or docker-compose.dev.yml).
# Docker Compose loads .env; the bare Go executable does not.
# Keep real credentials in .env, which is excluded from Git.

# Native browser/client address. Include the host port when it is not 80/443.
# If you change NOX_FRONTEND_PORT, update this URL as well.
# HTTP private origins and HTTPS origins are both supported.
NOX_BACKEND_PUBLIC_URL=http://localhost:5710
# Google credentials and allowed accounts belong only to the running NoX Auth.
NOX_AUTH_PUBLIC_URL=https://auth.example.test

# Published images. Frontend inherits the Backend tag when left empty.
NOX_BACKEND_IMAGE_TAG=latest
NOX_FRONTEND_IMAGE_TAG=
NOX_FRONTEND_PORT=5710

# Container-internal settings; these are not the external browser/client URL.
# Changing the Backend listener requires updating the frontend target too.
NOX_BACKEND_ADDR=:8080
NOX_FRONTEND_BACKEND_URL=http://backend:8080
NOX_BACKEND_DATA_DIR=/data
# Leave empty to report the version embedded in the image.
NOX_BACKEND_VERSION=

# Existing installations: preserve your actual Backend data volume name.
# Development Compose uses ./data instead of this named data volume.
NOX_BACKEND_DATA_VOLUME_NAME=nox-backend-data

# Same-host Suite channel. Use the same local volume name in Gateway/Yard.
# Compose mounts it at /run/nox-suite automatically; no certificates are needed.
NOX_SUITE_LOCAL_VOLUME_NAME=nox-suite-local
# Setup alone receives the existing Auth administration volume.
NOX_AUTH_ADMIN_VOLUME_NAME=nox-auth-admin
# Direct /mcp keeps its existing behavior. Suite /mcp/suite is opt-in and local-only.
# Gateway/Yard pairing does not require enabling Backend's own Suite MCP tools.
NOX_BACKEND_DIRECT_MCP_ENABLED=true
# When enabled, the existing administrator dashboard publishes Backend tools automatically.
NOX_BACKEND_SUITE_MCP_ENABLED=false
# Reporting/freshness intervals in milliseconds; unrelated to login/session duration.
NOX_BACKEND_SUITE_REPORT_INTERVAL_MS=15000
NOX_BACKEND_SUITE_OBSERVATION_FRESHNESS_MS=45000

# Optional direct TLS on the Backend's native listener, not Suite communication.
# Paths must exist INSIDE the container via explicitly configured certificate mounts.
# Adapt NOX_FRONTEND_BACKEND_URL and healthcheck CA settings if using direct TLS.
# An existing HTTPS reverse proxy does not require enabling these options.
# NOX_BACKEND_TLS_CERT_FILE=/certificates/server.crt
# NOX_BACKEND_TLS_KEY_FILE=/certificates/server.key
# NOX_BACKEND_TLS_CA_FILE=/certificates/root.crt

# Bare Go execution only: explicitly set a shared same-host socket directory.
# Images/Compose already configure /run/nox-suite; this line does not override it.
# NOX_BACKEND_SUITE_SOCKET_DIR=/absolute/shared-directory
